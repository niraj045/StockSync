MYSQL_DATABASE=shuttering_inventory
MYSQL_USER=stocksync_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3307

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
TZ=Asia/Kolkata

APP_DOMAIN=stocksync.caretakers.ind.in
APP_ORIGIN=https://stocksync.caretakers.ind.in
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=7d
SESSION_COOKIE_MAX_AGE=7d

JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

UPLOAD_STORAGE_PATH=/data/uploads
DOCUMENT_STORAGE_PATH=/data/documents
REPORT_STORAGE_PATH=/data/reports

APP_UID=1000
APP_GID=1000
BACKUP_RETENTION_DAYS=14
