APP_HTTP_PORT=80
APP_HTTPS_PORT=443
SERVER_NAME=stocksync.example.com
DB_NAME=shuttering_inventory
DB_USER=inventory_user
DB_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_LEAK_DETECTION_MS=0
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=30m
JAVA_MAX_RAM_PERCENTAGE=75
MYSQL_CPU_LIMIT=0.75
MYSQL_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.00
BACKEND_MEMORY_LIMIT=768m
FRONTEND_CPU_LIMIT=0.25
FRONTEND_MEMORY_LIMIT=128m
BACKUP_CPU_LIMIT=0.20
BACKUP_MEMORY_LIMIT=128m
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
OFFSITE_BACKUP_PATH=./backups/offsite
TLS_CERT_PATH=./deployment/tls/fullchain.pem
TLS_KEY_PATH=./deployment/tls/privkey.pem
